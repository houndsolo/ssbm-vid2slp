+// vid2slp addition: Slippi replay playback for the headless Linux host. See replay_source.h.
+// Ported from port/app/source_host.cpp (set_replay, h_replay_frame, replay_codes,
+// read_replay_event) and port/runtime/hle/slippi_playback.cpp (gameplay_codes), without the
