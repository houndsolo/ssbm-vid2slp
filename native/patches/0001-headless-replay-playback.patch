+  static const Known known[] = {
+      {0x800D65EC, MU_REPLAY_CODE_UCF084}, {0x800C9A44, MU_REPLAY_CODE_UCF084}, {0x8006B460, MU_REPLAY_CODE_UCF084},
+      {0x8008E54C, MU_REPLAY_CODE_UCF084}, {0x8009A0B8, MU_REPLAY_CODE_UCF084}, {0x800998A4, MU_REPLAY_CODE_UCF084},
+      {0x80093294, MU_REPLAY_CODE_UCF084}, {0x800908F4, MU_REPLAY_CODE_UCF084},
+      {0x8016E510, MU_REPLAY_CODE_NEUTRAL_SPAWN}, {0x801239A8, MU_REPLAY_CODE_FREEZE_GLITCH},
+      {0x801C154C, MU_REPLAY_CODE_INIT_STAGE_DATA}, {0x80068EEC, MU_REPLAY_CODE_INIT_PLAYER_DATA},
+      {0x8006A880, MU_REPLAY_CODE_OFFSCREEN_DAMAGE},
+      {0x800D4C1C, MU_REPLAY_CODE_DEAD_UP_FALL}, {0x800D4D68, MU_REPLAY_CODE_DEAD_UP_FALL},
+      {0x80080E80, MU_REPLAY_CODE_DEAD_UP_FALL},
+      {0x8021AAE4, MU_REPLAY_CODE_FD_BG_SEED}, {0x801C65C8, MU_REPLAY_CODE_PS_ZERO_BUFFER},
+      {0x801D4760, MU_REPLAY_CODE_PS_IS_VALID}, {0x801D457C, MU_REPLAY_CODE_PS_FROZEN_CHECK},
+      {0x800165AC, MU_REPLAY_CODE_PS_FILE_LOAD}, {0x8008653C, MU_REPLAY_CODE_WHISPY_FIX},
+      {0x800AC5B8, MU_REPLAY_CODE_NANA_DETERMINISM}, {0x801D24FC, MU_REPLAY_CODE_PS_MONITOR},
+      {0x800DB880, MU_REPLAY_CODE_PREVENT_WOBBLING}, {0x800DBBD4, MU_REPLAY_CODE_PREVENT_WOBBLING},
+      {0x8008F090, MU_REPLAY_CODE_PREVENT_WOBBLING},
+      {0x80179378, 0}, {0x8017900C, 0}, {0x8017A890, 0}, {0x8000568C, 0}, {0x802F84C8, 0},
+  };
+  auto deny = build_denylist(sys_dir);
+  uint32_t codes = 0;
+  size_t idx = 0, kept = 0, unknown = 0;
+  while (idx + 8 <= list.size()) {   // walk the Gecko list (slippi_playback.cpp gameplay_codes)
+    const uint8_t type = list[idx] & 0xFE;
+    uint32_t address = be32(&list[idx]);
+    address = (address & 0x01FFFFFF) | 0x80000000;
+    const uint32_t word = be32(&list[idx + 4]);
+    size_t len = 8;
+    if (type == 0xC0 || type == 0xC2) len = 8 + (size_t)word * 8;
+    else if (type == 0x08) len = 16;
+    else if (type == 0x06) len = 8 + ((word + 7) & ~7u);
+    if (idx + len > list.size()) break;
+    auto it = deny.find(address);
+    const bool denied = it != deny.end() && it->second;
+    if (!denied) {
+      ++kept;
+      const Known* k = nullptr;
+      for (const auto& e : known) if (e.address == address) { k = &e; break; }
+      if (!k) {
+        ++unknown;
+        logf("replay: code %08X (type %02X) is not implemented natively; this replay may diverge", address, type);
+        if ((address == 0x800C9A44 || address == 0x800998A4) && !(codes & MU_REPLAY_CODE_UCF084))
+          codes |= MU_REPLAY_CODE_UCF_OTHER;
+      } else {
+        codes |= k->code;
+        if (address == 0x801D457C && len >= 8 + 12) *ps_frozen_toggle = list[idx + 8 + 8];
+      }
+    }
+    idx += len;
+  }
+  logf("replay: code list %zu bytes, %zu gameplay codes kept, %zu not native; codes mask %08X",
+       list.size(), kept, unknown, codes);
+  return codes;
+}
+
+}  // namespace
+
+bool load(const std::string& path, const std::string& sys_dir, bool resync, const std::string& codes_path) {
+  game = Slippi::SlippiGame::FromFile(path);
+  if (!game || !game->AreSettingsLoaded()) {
+    logf("replay: cannot read %s", path.c_str());
+    game.reset();
+    return false;
+  }
+  start_payload = read_event(path, 0x36);
+  if (start_payload.empty()) {
+    logf("replay: %s has no Game Start event", path.c_str());
+    game.reset();
+    return false;
+  }
+  Slippi::GameSettings* s = game->GetSettings();
+  codes_list = s->geckoCodes;
+  if (!codes_path.empty()) {
+    std::ifstream f(codes_path, std::ios::binary);
+    codes_list.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+    if (codes_list.empty()) { logf("replay: cannot read code list %s", codes_path.c_str()); game.reset(); return false; }
+    logf("replay: using the code list from %s instead of the replay's", codes_path.c_str());
+  }
+  std::array<uint32_t, Slippi::GAME_INFO_HEADER_SIZE> header = s->header;
+  // Dolphin's prepareGameInfo: a player who is Sheik or Zelda gets that character in the header.
+  for (int i = 0; i < 4; ++i) {
+    if (!game->DoesPlayerExist((int8_t)i)) continue;
+    const uint8_t ext = s->players[(uint8_t)i].characterId;
+    if (ext != 0x12 && ext != 0x13) continue;
+    header[24 + 9 * i] = (header[24 + 9 * i] & 0x00FFFFFFu) | (uint32_t)ext << 24;
+  }
+  for (int i = 0; i < Slippi::GAME_INFO_HEADER_SIZE; ++i)
+    for (int b = 0; b < 4; ++b) start_info.game_info[4 * i + b] = (uint8_t)(header[i] >> (24 - 8 * b));
+  start_info.random_seed = s->randomSeed;
+  start_info.is_pal = s->isPAL;
+  auto version = game->GetVersion();
+  start_info.preload_ps = version[0] > 1 || (version[0] == 1 && version[1] > 2);
+  start_info.frozen_ps = s->isFrozenPS;
+  start_info.resync = resync ? 1 : 0;
+  if (codes_list.empty()) logf("replay: %s stores no code list (old replay); playing without gameplay codes", path.c_str());
+  start_info.codes = replay_codes(codes_list, sys_dir, &start_info.ps_frozen_toggle);
+  logf("replay: %s, Slippi %s, frames %d..%d, stage %u, seed %08X, frozen PS %u%s", path.c_str(),
+       game->GetVersionString().c_str(), Slippi::GAME_FIRST_FRAME, game->GetLatestIndex(),
+       (unsigned)s->stage, s->randomSeed, (unsigned)s->isFrozenPS, resync ? ", resync on" : "");
+  return true;
+}
+
+bool active() { return game != nullptr; }
+const MuReplayStart* start() { return game ? &start_info : nullptr; }
+const std::vector<uint8_t>& game_start_payload() { return start_payload; }
+const std::vector<uint8_t>& gecko_codes() { return codes_list; }
+
+void frame(int32_t index, MuReplayFrame* out) {
+  *out = MuReplayFrame{};
+  if (!game || !game->DoesFrameExist(index)) { out->result = MU_REPLAY_TERMINATE; return; }
+  Slippi::FrameData* f = game->GetFrame(index);
+  out->result = MU_REPLAY_CONTINUE;
+  out->seed_exists = f->randomSeedExists && use_frame_seeds ? 1 : 0;
+  out->seed = f->randomSeed;
+  if (auto s = seed_overrides.find(index); s != seed_overrides.end()) {
+    out->seed_exists = 1;
+    out->seed = s->second;
+  }
+  for (uint8_t port = 0; port < 4; ++port) {
+    for (int follower = 0; follower < 2; ++follower) {
+      const auto& source = follower ? f->followers : f->players;
+      auto it = source.find(port);
+      if (it == source.end()) continue;
+      const Slippi::PlayerFrameData& d = it->second;
+      MuReplayCharacter& c = out->character[port][follower];
+      c.present = 1;
+      c.random_seed = d.randomSeed;
+      c.joystick_x = d.joystickX; c.joystick_y = d.joystickY; c.cstick_x = d.cstickX; c.cstick_y = d.cstickY;
+      c.trigger = d.trigger;
+      c.buttons = d.buttons;
+      c.x = d.locationX; c.y = d.locationY; c.facing = d.facingDirection;
+      c.action_state = d.animation;
+      c.percent = d.percent;
+      c.joystick_x_raw = d.joystickXRaw; c.joystick_y_raw = d.joystickYRaw;
+      c.cstick_x_raw = d.cstickXRaw; c.cstick_y_raw = d.cstickYRaw;
+      if (follower) continue;   // overrides are for the main character of a port
+      auto in = input_overrides.find({index, port});
+      if (in != input_overrides.end()) {
+        const InputOverride& o = in->second;
+        c.joystick_x = o.f[0]; c.joystick_y = o.f[1]; c.cstick_x = o.f[2]; c.cstick_y = o.f[3];
+        c.trigger = o.f[4];
+        c.buttons = o.buttons;
+        c.joystick_x_raw = o.raw[0]; c.joystick_y_raw = o.raw[1];
+        c.cstick_x_raw = o.raw[2]; c.cstick_y_raw = o.raw[3];
+      }
+      auto st = state_overrides.find({index, port});
+      if (st != state_overrides.end()) {
+        const StateOverride& o = st->second;
+        c.x = o.x; c.y = o.y; c.facing = o.facing; c.action_state = o.action; c.percent = o.percent;
+      }
+    }
+  }
+}
+
+int32_t stock_steal(int32_t index, int32_t port) {
+  if (!game || !game->DoesFrameExist(index)) return 0;
+  return game->GetFrame(index)->players.count((uint8_t)port) ? 1 : 0;
+}
+
+bool command(const std::string& line, std::string* reply) {
+  std::istringstream in(line);
+  std::string name;
+  in >> name;
+  if (name == "clear-overrides") {
+    input_overrides.clear();
+    state_overrides.clear();
+    seed_overrides.clear();
+    *reply = "OK\n";
+    return true;
+  }
+  if (name == "override-seed") {
+    int32_t index = 0;
+    uint32_t seed = 0;
+    in >> index >> seed;
+    if (!in) { *reply = "ERROR override-seed needs a frame and a seed\n"; return true; }
+    seed_overrides[index] = seed;
+    *reply = "OK\n";
+    return true;
+  }
+  if (name == "frame-seeds") {
+    int on = 1;
+    in >> on;
+    use_frame_seeds = on != 0;
+    *reply = "OK\n";
+    return true;
+  }
+  if (name != "override" && name != "override-state") return false;
+  int32_t index = 0, port = 0;
+  in >> index >> port;
+  if (!in || port < 0 || port > 3) { *reply = "ERROR bad frame/port\n"; return true; }
+  if (name == "override") {
+    InputOverride o{};
+    int raw[4];
+    in >> o.f[0] >> o.f[1] >> o.f[2] >> o.f[3] >> o.f[4] >> o.buttons >> raw[0] >> raw[1] >> raw[2] >> raw[3];
+    if (!in) { *reply = "ERROR override needs 10 values\n"; return true; }
+    for (int i = 0; i < 4; ++i) o.raw[i] = (uint8_t)(int8_t)raw[i];   // raw stick bytes are signed
+    input_overrides[{index, port}] = o;
+  } else {
+    StateOverride o{};
+    in >> o.x >> o.y >> o.facing >> o.action >> o.percent;
+    if (!in) { *reply = "ERROR override-state needs 5 values\n"; return true; }
+    state_overrides[{index, port}] = o;
+  }
+  *reply = "OK\n";
+  return true;
+}
+
+}  // namespace linux_host::replay
