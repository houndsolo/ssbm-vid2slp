+struct StateOverride { float x, y, facing; uint32_t action; float percent; };
+std::map<std::pair<int32_t, int32_t>, InputOverride> input_overrides;
+std::map<std::pair<int32_t, int32_t>, StateOverride> state_overrides;
+// "frame-seeds 0": don't force the file's per-frame random seeds (a rebuilt game must not use the
+// original's seeds; the RNG then runs on from the game start seed, and the recording stores it).
