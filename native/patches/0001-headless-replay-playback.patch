--- /dev/null
+++ b/port/linux/replay_source.h
@@ -0,0 +1,54 @@
+// vid2slp addition: Slippi replay playback for the HEADLESS Linux host (host API version 9).
+// The desktop host (port/app/source_host.cpp, --replay) has this; the headless host did not.
+// The game library already contains Slippi's playback codes natively (sourceport/game/shim/
+// mu_replay.c): the host only answers "what does the replay say for this frame" (inputs, seed,
+// and with resync the stored start-of-frame position / facing / action / percent).
+//
+// On top of the file's data, a controller (vid2slp's Python side, over the control socket) can
+// OVERRIDE any frame's inputs and stored states before that frame is played. This is what makes
+// the engine usable as a simulator: capture a checkpoint, try some inputs, restore, try others.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "mu_host.h"
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace linux_host::replay {
+
+// Load a .slp. sys_dir is a Slippi Playback "Sys" folder (its Slippi/InjectionLists say which of
+// the replay's Gecko codes affect gameplay). Returns false (and logs) on failure.
+// codes_path (optional): a file with a raw Gecko code list to use INSTEAD of the replay's own (both
+// for playing and in the new recording). vid2slp writes UCF 0.84 this way, the only UCF version
+// the game library implements.
+bool load(const std::string& path, const std::string& sys_dir, bool resync, const std::string& codes_path = "");
+bool active();
+
+// Host API callbacks (see MuHostApi in port/runtime/abi/mu_host.h).
+const MuReplayStart* start();
+void frame(int32_t frame, MuReplayFrame* out);
+int32_t stock_steal(int32_t frame, int32_t port);
+
+// The original Game Start payload and Gecko code list (the new recording reuses them, as the
+// desktop host does).
+const std::vector<uint8_t>& game_start_payload();
+const std::vector<uint8_t>& gecko_codes();
+
+// Control-socket commands; returns true when the line was one of these (reply already in *reply).
+//   override <frame> <port> <stick_x> <stick_y> <cstick_x> <cstick_y> <trigger> <buttons>
+//            <raw_stick_x> <raw_stick_y> <raw_cstick_x> <raw_cstick_y>
+//       replace the inputs (processed floats, processed button word, raw stick bytes)
+//   override-state <frame> <port> <x> <y> <facing> <action> <percent>
+//       replace the stored start-of-frame state that resync forces (only used with resync on)
+//   override-seed <frame> <seed>
+//       force this random seed at the start of that frame
+//   frame-seeds <0|1>
+//       0 = don't force the file's per-frame random seeds
+//   clear-overrides
+//       forget all overrides
+// Overrides live in this process's memory, so a checkpoint restore brings back the overrides that
+// existed when the checkpoint was captured.
+bool command(const std::string& line, std::string* reply);
+
+}  // namespace linux_host::replay
